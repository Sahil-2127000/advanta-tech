# Copy this file to `.env` and fill it in. `.env` is git-ignored.
# In production, add the same variables in your hosting provider's environment settings
# (Vercel / Netlify / Cloudflare Pages) and redeploy — they are built into the site.
#
# Note: these values are displayed on the website, so they are visible to visitors.
# Keeping them here only keeps them out of the source code and the git repository.

# ── Contact (required) ─────────────────────────────────────────────
VITE_CONTACT_EMAIL=you@example.com
# International format, e.g. +919876543210
VITE_CONTACT_PHONE=+910000000000

# ── Address (required) ─────────────────────────────────────────────
VITE_ADDRESS_STREET=Plot No. 0, Phase 0, Industrial Area
VITE_ADDRESS_AREA=Sector 00
VITE_ADDRESS_CITY=Your City
VITE_ADDRESS_REGION=Your State
VITE_ADDRESS_POSTCODE=000000

# ── Optional ───────────────────────────────────────────────────────
# WhatsApp number, digits only with country code. Defaults to VITE_CONTACT_PHONE.
VITE_WHATSAPP_NUMBER=
# Inbox that receives form enquiries by email. Defaults to VITE_CONTACT_EMAIL.
VITE_ENQUIRY_INBOX=
# Send enquiries somewhere other than email, e.g. a Google Apps Script URL (see README).
VITE_ENQUIRY_ENDPOINT=
