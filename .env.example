# Where the enquiry form sends submissions.
# Leave empty (default): each enquiry is emailed to site.enquiryInbox (src/config/site.js) via FormSubmit.
# Optional: paste a Google Apps Script web app URL (ends in /exec) to save enquiries to a Google Sheet instead
# — see README → "Enquiries to Google Sheets".
VITE_ENQUIRY_ENDPOINT=
